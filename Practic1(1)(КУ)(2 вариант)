Вставил внутрь nano src/vfs.py:
import xml.etree.ElementTree as ET
import base64

class VfsError(Exception):
    pass

class Vfs:
    def __init__(self, name="default_vfs"):
        self.name = name
        self.root = {} # Словарь для хранения: {'file.txt': 'content', 'dir': {'nested.txt': 'data'}}

    @classmethod
    def from_xml(cls, path):
        """Загружает VFS из XML в память."""
        try:
            tree = ET.parse(path)
        except FileNotFoundError:
            raise VfsError(f"Файл не найден: {path}")
        except ET.ParseError:
            raise VfsError(f"Неверный формат XML: {path}")

        root = tree.getroot()
        if root.tag != "vfs":
            raise VfsError("Корневой тег должен быть <vfs>")

        name = root.get("name", "vfs")
        vfs = cls(name)
        vfs.root = vfs._parse_children(root)
        return vfs

    def _parse_children(self, element):
        data = {}
        for child in element:
            if child.tag == "file":
                fname = child.get("name")
                content = child.get("content", "")
                # Если указано base64, декодируем в память
                if child.get("encoding") == "base64":
                    try:
                        content = base64.b64decode(content)
                    except Exception:
                        raise VfsError(f"Ошибка base64 в файле {fname}")
                data[fname] = content
            elif child.tag == "dir":
                dname = child.get("name")
                data[dname] = self._parse_children(child)
        return data

    def init_default(self):
        """Команда vfs-init: заменяет текущую VFS на VFS по умолчанию."""
        self.name = "default_vfs"
        self.root = {}
        print("VFS инициализирована по умолчанию (очищена).")

