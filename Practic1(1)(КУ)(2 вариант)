def execute_command(cmd, args, vfs):
    """Выполняет команду, принимая объект VFS."""
    if cmd == "exit":
        return True
    elif cmd in ("ls", "cd"):
        print(f"Заглушка {cmd}. Аргументы: {args}")
        return True
    elif cmd == "vfs-init":
        vfs.init_default()
        return True
    else:
        print(f"Ошибка: неизвестная команда '{cmd}'")
        return False

def run_script(script_path, vfs):
    print(f"[DEBUG] Выполнение скрипта: {script_path}")
    try:
        with open(script_path, 'r', encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                
                print(f"{vfs.name}> {line}")
                cmd, args = parse_input(line)
                
                if cmd == "exit":
                    return True
                if not execute_command(cmd, args, vfs):
                    print(f"Остановка скрипта из-за ошибки: {line}")
                    sys.exit(1)
    except FileNotFoundError:
        print(f"Ошибка: Скрипт не найден - {script_path}")
        sys.exit(1)
    return False

def run_repl(vfs):
    print(f"Добро пожаловать в эмулятор оболочки. VFS: {vfs.name}")
    while True:
        try:
            line = input(f"{vfs.name}> ")
        except (EOFError, KeyboardInterrupt):
            print("\nВыход.")
            break
            
        if not line.strip():
            continue
            
        cmd, args = parse_input(line)
        if cmd == "exit":
            break
        execute_command(cmd, args, vfs)

def main():
    parser = argparse.ArgumentParser(description="Эмулятор Shell")
    parser.add_argument("--vfs", help="Путь к VFS (XML)")
    parser.add_argument("--script", help="Путь к стартовому скрипту")
    args = parser.parse_args()

    print(f"[DEBUG] VFS path: {args.vfs}")
    print(f"[DEBUG] Script path: {args.script}")

    # Инициализация VFS
    if args.vfs:
        try:
            vfs = Vfs.from_xml(args.vfs)
        except VfsError as e:
            print(f"Ошибка загрузки VFS: {e}")
            sys.exit(1)
    else:
        vfs = Vfs()

    print(f"[DEBUG] VFS name: {vfs.name}")

    script_did_exit = False
    if args.script:
        script_did_exit = run_script(args.script, vfs)

    if not script_did_exit:
        run_repl(vfs)

if __name__ == "__main__":
    main()


