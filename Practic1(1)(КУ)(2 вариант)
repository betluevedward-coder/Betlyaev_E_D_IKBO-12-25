import os
import shlex
import sys
import argparse

def parse_input(line):
    expanded = os.path.expandvars(line)
    try:
        tokens = shlex.split(expanded)
    except ValueError:
        return line.strip(), []
    if not tokens:
        return "", []
    return tokens[0], tokens[1:]

def execute_command(cmd, args, vfs_name):
    """Выполняет одну команду. Возвращает True, если успешно."""
    if cmd == "exit":
        return True
    elif cmd in ("ls", "cd"):
        print(f"Заглушка {cmd}. Аргументы: {args}")
        return True
    else:
        print(f"Ошибка: неизвестная команда '{cmd}'")
        return False

def run_script(script_path, vfs_name):
    """Выполняет стартовый скрипт. Останавливается при первой ошибке."""
    print(f"[DEBUG] Выполнение скрипта: {script_path}")
    try:
        with open(script_path, 'r', encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue # Пропускаем пустые строки и комментарии
                
                # Имитируем диалог: выводим ввод
                print(f"{vfs_name}> {line}")
                cmd, args = parse_input(line)
                
                if cmd == "exit":
                    return True
                if not execute_command(cmd, args, vfs_name):
                    print(f"Остановка скрипта из-за ошибки в команде: {line}")
                    sys.exit(1)
    except FileNotFoundError:
        print(f"Ошибка: Скрипт не найден - {script_path}")
        sys.exit(1)
    return False

def run_repl(vfs_name):
    print(f"Добро пожаловать в эмулятор оболочки. VFS: {vfs_name}")
    while True:
        try:
            line = input(f"{vfs_name}> ")
        except (EOFError, KeyboardInterrupt):
            print("\nВыход.")
            break
            
        if not line.strip():
            continue
            
        cmd, args = parse_input(line)
        if cmd == "exit":
            break
        execute_command(cmd, args, vfs_name)

def main():
    parser = argparse.ArgumentParser(description="Эмулятор Shell")
    parser.add_argument("--vfs", help="Путь к VFS")
    parser.add_argument("--script", help="Путь к стартовому скрипту")
    args = parser.parse_args()

    # Отладочный вывод параметров
    print(f"[DEBUG] VFS path: {args.vfs}")
    print(f"[DEBUG] Script path: {args.script}")

    # Пока VFS - это просто имя (файл XML подключим на этапе 3)
    vfs_name = "default_vfs"
    if args.vfs:
        # Извлекаем имя файла без расширения для отображения в консоли
        vfs_name = os.path.basename(args.vfs).split('.')[0]

    # Если передан скрипт - выполняем его
    script_did_exit = False
    if args.script:
        script_did_exit = run_script(args.script, vfs_name)

    # Если в скрипте не было exit, запускаем интерактивный режим
    if not script_did_exit:
        run_repl(vfs_name)

if __name__ == "__main__":
    main()

