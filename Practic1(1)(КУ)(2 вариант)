import os
import shlex
import sys

# Имя VFS по умолчанию для первого этапа
VFS_NAME = "default_vfs"

def parse_input(line):
    """Разбирает строку на команду и аргументы, раскрывая $VAR."""
    expanded = os.path.expandvars(line)
    try:
        tokens = shlex.split(expanded)
    except ValueError:
        return line.strip(), []
    if not tokens:
        return "", []
    return tokens[0], tokens[1:]

def run_repl():
    """Основной цикл REPL."""
    print(f"Добро пожаловать в эмулятор оболочки. VFS: {VFS_NAME}")
    while True:
        try:
            # Приглашение содержит имя VFS
            line = input(f"{VFS_NAME}> ")
        except (EOFError, KeyboardInterrupt):
            print("\nВыход.")
            break
            
        if not line.strip():
            continue
            
        cmd, args = parse_input(line)
        
        if cmd == "exit":
            break
        elif cmd in ("ls", "cd"):
            # Команды-заглушки
            print(f"Заглушка {cmd}. Аргументы: {args}")
 else:
            print(f"Ошибка: неизвестная команда '{cmd}'")

if __name__ == "__main__":
    run_repl()


